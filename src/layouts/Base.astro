---
import '@fontsource-variable/roboto/index.css';
import '../styles/global.css';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** An uploaded photo to show when the page is shared. */
  image?: string;
  type?: 'website' | 'article';
}

const { title, description = SITE.description, image = SITE.shareImage, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} – ${SITE.name}` : `${SITE.name} – ${SITE.homeTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(image, Astro.site);
const year = new Date().getFullYear();

const nav = [
  { href: '/#services', label: 'Lessons' },
  { href: '/#Get1Help2', label: 'Get1Help2' },
  { href: SITE.wiki, label: 'Able Bodied Wiki' },
  { href: '/blog/', label: 'Blog' },
  { href: '/donate/', label: 'DONATE' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="bar">
        <a href="/" class="brand" rel="home">
          <img src="/logo.jpg" alt="" width="180" height="62" />
          <span class="site-title">{SITE.name}</span>
        </a>
        <details class="menu">
          <summary aria-label="Main menu"><span class="burger" aria-hidden="true"></span></summary>
          <nav aria-label="Main">
            <ul>
              {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>Copyright © {year} {SITE.name}</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    background: #fff;
    position: relative;
    z-index: 50;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 93px;
    width: min(100% - 40px, 1200px);
    margin-inline: auto;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 15px;
    text-decoration: none;
  }
  .brand img {
    width: 180px;
    height: auto;
  }
  .site-title {
    font-family: var(--system);
    font-size: 35px;
    font-weight: 600;
    color: var(--body);
    white-space: nowrap;
  }
  @media (max-width: 921px) {
    .brand img {
      width: 120px;
    }
    .site-title {
      font-size: 24px;
    }
  }
  @media (max-width: 480px) {
    .site-title {
      display: none;
    }
  }
  .menu summary {
    list-style: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--link);
    position: relative;
  }
  .burger::before,
  .burger::after {
    content: '';
    position: absolute;
  }
  .burger::before {
    top: -6px;
  }
  .burger::after {
    top: 6px;
  }
  .menu[open] .burger {
    background: transparent;
  }
  .menu[open] .burger::before {
    top: 0;
    transform: rotate(45deg);
  }
  .menu[open] .burger::after {
    top: 0;
    transform: rotate(-45deg);
  }
  .menu nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: #fff;
    border-top: 1px solid #eaeaea;
    box-shadow: 0 8px 16px rgb(0 0 0 / 0.08);
  }
  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu a {
    display: block;
    padding: 12px 20px;
    color: var(--link);
    font-size: 15px;
    text-decoration: none;
    border-bottom: 1px solid #eaeaea;
  }
  @media (min-width: 922px) {
    .menu summary {
      display: none;
    }
    .menu > nav {
      position: static;
      display: block;
      border: 0;
      box-shadow: none;
      background: none;
    }
    .menu ul {
      display: flex;
    }
    .menu a {
      border: 0;
      padding: 0 15px;
      line-height: 93px;
    }
    .menu a:hover {
      text-decoration: underline;
    }
  }
  .site-footer {
    border-top: 1px solid #dddddd;
    text-align: center;
    padding: 20px;
    font-size: 15px;
    color: var(--body);
    background: #fff;
  }
  .site-footer p {
    margin: 0;
  }
</style>

<script is:inline>
  // Wide screens show the menu as a row: keep the <details> open there.
  (() => {
    const menu = document.querySelector('.menu');
    if (!menu) return;
    const wide = matchMedia('(min-width: 922px)');
    const sync = () => { menu.open = wide.matches; };
    sync();
    wide.addEventListener('change', sync);
    menu.addEventListener('click', (e) => {
      if (!wide.matches && e.target instanceof HTMLAnchorElement) menu.open = false;
    });
  })();
</script>
