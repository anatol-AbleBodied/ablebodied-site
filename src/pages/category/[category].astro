---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts, CATEGORIES, CATEGORY_PAGES, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await allPosts();
  return CATEGORY_PAGES.map((category) => ({
    params: { category },
    props: { posts: posts.filter((p) => p.data.categories.includes(category)) },
  }));
}

interface Props {
  posts: Post[];
}

const { category } = Astro.params;
const { posts } = Astro.props;
const label = CATEGORIES[category] ?? category;
---

<Base title={label}>
  <div class="boxed">
    <div class="wrap">
      <header class="entry archive">
        <h1 class="entry-title">Category: {label}</h1>
      </header>
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </div>
</Base>

<style>
  .archive {
    padding-block: 30px;
  }
  .archive h1 {
    margin: 0;
  }
</style>
