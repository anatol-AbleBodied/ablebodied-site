---
import Base from '../layouts/Base.astro';
const form = 'https://docs.google.com/forms/d/e/1FAIpQLSfIZqINlLIDGSFfDcNPbGcEIHsv_vbBk474IUvNR20OxUyVfA/viewform';
---

<Base title="Reservation Form" description="Request a handcycle reservation with Able Bodied Inc.">
  <section class="section">
    <div class="narrow">
      <h1>Reserve a handcycle</h1>
      <p class="lead">Fill in the form below and we’ll follow up with the next steps. If it doesn’t load, <a href={form}>open the form in a new page</a>.</p>
      <div class="embed">
        <iframe src={`${form}?embedded=true`} title="Handcycle reservation form" loading="lazy"></iframe>
      </div>
    </div>
  </section>
</Base>

<style>
  .embed iframe {
    min-height: 1400px;
  }
</style>
