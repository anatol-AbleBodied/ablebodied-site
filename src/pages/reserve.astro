---
import Base from '../layouts/Base.astro';
---

<Base title="Reservation Form">
  <section class="section">
    <div class="wrap">
      <h1 class="visually-hidden">Reservation Form</h1>
      <div class="embed">
        <iframe
          src="https://docs.google.com/forms/d/e/1FAIpQLSfIZqINlLIDGSFfDcNPbGcEIHsv_vbBk474IUvNR20OxUyVfA/viewform?embedded=true"
          title="Reservation form"
          loading="lazy"></iframe>
      </div>
    </div>
  </section>
</Base>

<style>
  .embed iframe {
    min-height: 1400px;
  }
</style>
