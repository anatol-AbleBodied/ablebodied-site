---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';

const U = '/wp-content/uploads';
const board = [
  {
    name: 'Anatol Poppe',
    role: 'President',
    photo: `${U}/2024/06/Anatol-Poppe.jpg`,
    bio: 'Anatol is a full-time student studying to be an electrical engineer. He was 10 years old when his father was paralyzed in a bicycle accident. He helped his father convert his first handcycle to electric assist, which completely changed his father’s life — so much so that they decided to share the technology with the disabled community and started the Able Bodied handcycle program under NorCal SCI. Anatol is the “able bodied” help for all the one-on-one lessons and makes sure the rides are safe and the bikes are in good condition.',
  },
  {
    name: 'Wojtek Poppe',
    role: 'Treasurer / Test Dummy',
    photo: `${U}/2024/06/Wojtek.jpeg`,
    bio: 'Wojtek is a lifelong avid cyclist and outdoor enthusiast. He was a mountain biker, road biker, skier, windsurfer, hang gliding pilot and adventurer before he became a T5 complete paraplegic, with no sensation or muscle control below his chest. Electric-assist handcycling was the first activity that helped him feel “able bodied” again. He now rides with the same friends, on the same routes, as before he was paralyzed.',
  },
  {
    name: 'Natalie Zhar',
    role: 'Secretary',
    photo: `${U}/2024/06/Natalie-Zhar.jpeg`,
    bio: 'Natalie is an Assistant Professor at Stanford University School of Medicine. She has been an NIH-funded academic researcher in translational neuroscience, covering imaging and biomarkers, for over two decades. Her background in writing grants and running human studies makes her a key asset for Able Bodied and the disabled community.',
  },
  {
    name: 'Sam Kolb',
    role: 'Board Member',
    photo: `${U}/2024/06/Sam-Kolb.jpeg`,
    bio: 'Sam is an engineering leader with 25 years of experience building cutting-edge technology in Silicon Valley, in both startups and established companies, including the last five years as a senior manager at Meta working on large language models and AI. Sam was one of the first riders in the Able Bodied program and now runs Able Bodied Sonoma out of his house in Sebastopol.',
  },
  {
    name: 'Matthew Beadon',
    role: 'Board Member',
    photo: `${U}/2024/10/Screenshot-2024-10-24-at-10.16.23-AM-Medium.jpeg`,
    bio: 'Matt is an adventure-seeking engineer whose one-year experiment in Silicon Valley has lasted two decades (so far). He loves cycling and wants to help more people have able-bodied experiences among the coastal redwoods.',
  },
  {
    name: 'Suet Fei Li',
    role: 'Board Member',
    photo: `${U}/2024/10/Screenshot-2024-10-24-at-10.31.58-AM.png`,
    bio: 'Born in China and educated in the US, Suet Fei is an avid runner who represented Hong Kong in international competitions. She has seen the uplifting impact of sport — purpose and meaning, strong communities, better physical and mental health — and is passionate about making sports accessible to people of all ages, economic backgrounds and physical abilities. When she isn’t running, she is a software engineer at Google.',
  },
  {
    name: 'Shara Poppe',
    role: 'Board Member',
    photo: `${U}/2024/10/Screenshot-2024-10-31-at-10.54.35-AM.png`,
    bio: 'Shara is an experienced nurse manager in oncology and an avid runner and hiker. She competes in ultramarathons and recently qualified for the Boston Marathon. She enjoys hikes and bike rides with her paralyzed husband, Wojtek, and has seen first-hand how life-changing electric-assist handcycling can be, not only for the rider but for the whole family.',
  },
];
---

<Base title="Board of Directors" description="Meet the board of directors of Able Bodied Inc.">
  <section class="section">
    <div class="wrap">
      <h1>Board of directors</h1>
      <p class="lead">A diverse group of life- and adventure-loving world travelers and DIY tinkerers.</p>
      <ul class="people">
        {
          board.map((p) => (
            <li class="card">
              <Pic src={p.photo} alt={`Portrait of ${p.name}`} sizes="160px" class="face" />
              <div class="card-body">
                <h2>{p.name}</h2>
                <p class="role">{p.role}</p>
                <p>{p.bio}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .people {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 20px;
  }
  .people .card {
    flex-direction: row;
    align-items: flex-start;
    gap: 0;
  }
  .people :global(.face) {
    width: 140px;
    height: 140px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    margin: 20px 0 20px 20px;
    flex: none;
  }
  @media (max-width: 600px) {
    .people .card {
      flex-direction: column;
    }
    .people :global(.face) {
      width: 112px;
      height: 112px;
    }
  }
  .people h2 {
    font-size: 1.35rem;
    margin-bottom: 0.15em;
  }
  .role {
    color: var(--accent);
    font-weight: 700;
  }
</style>
