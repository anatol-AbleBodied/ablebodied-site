---
import Base from '../layouts/Base.astro';
---

<Base title="Fundraiser" description="Able Bodied's December 2024 fundraiser video premiere and Q&A.">
  <section class="section">
    <div class="narrow">
      <p class="eyebrow">Past event · December 3, 2024</p>
      <h1>Fundraiser video premiere</h1>
      <p class="lead">We premiered our fundraiser video on December 3, 2024, with a live Q&amp;A afterwards. You can still watch it, and donations are always welcome.</p>
      <div class="embed video">
        <iframe src="https://www.youtube-nocookie.com/embed/jbaT4KMNRfQ" title="Able Bodied fundraiser video" loading="lazy" allowfullscreen></iframe>
      </div>
      <div class="btn-row">
        <a class="btn accent" href="/donate/">Donate now</a>
        <a class="btn ghost" href="https://www.youtube.com/watch?v=jbaT4KMNRfQ">Watch on YouTube</a>
      </div>
    </div>
  </section>
</Base>
