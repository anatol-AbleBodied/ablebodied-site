---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import Video from '../components/Video.astro';
import Gallery from '../components/Gallery.astro';
import Social from '../components/Social.astro';
import { picture } from '../lib/picture.mjs';
import { SITE } from '../lib/site';

const U = '/wp-content/uploads';
const hero = picture(`${U}/2024/06/Monster-All-Wheel-Drive-Handcycle.jpg`);
const L = SITE.links;
const travelGuide = 'https://docs.google.com/document/d/1wqWwDZsvtk4lhqjW9FA9I_o19GyIyN-BOqRJg4FxiTM/edit?usp=sharing';
const survey = 'https://forms.gle/AhGqfshQWgsxHwgs8';
const buildForm = 'https://forms.gle/6GEjErcZsiKLRk6h7';

const gallery = [
  ['2021/02/IMG_20200702_174321-scaled.jpg', ''],
  ['2021/02/IMG_20200426_165052-scaled.jpg', 'Top of Monitor pass with son (3,600 ft)'],
  ['2021/02/IMG_20200613_160616-scaled.jpg', 'Biking in Napa and picnicking at a winery.'],
  ['2022/04/IMG_4173-scaled.jpg', 'Riding down Kennedy Rd'],
  ['2022/04/IMG_4324-scaled.jpg', 'Happy handshake after lesson'],
  ['2022/04/IMG_4731-scaled.jpg', 'Good times after lesson'],
  ['2022/04/IMG_6809-scaled.jpg', ''],
  ['2022/04/IMG_3081.jpg', ''],
  ['2022/04/IMG_3077-3-scaled.jpg', ''],
  ['2022/04/IMG_3627-scaled.jpg', ''],
  ['2022/04/IMG_3673-scaled.jpg', ''],
  ['2022/04/IMG_4323-scaled.jpg', 'Going down Leigh Ave. during lesson'],
  ['2022/04/IMG_5348-scaled.jpg', '51 mile ride up Black Mountain (fire road no problem)'],
  ['2022/04/IMG_5593-scaled.jpg', ''],
  ['2022/04/IMG_4343-scaled.jpg', ''],
  ['2021/02/IMG_20200503_163052-scaled.jpg', ''],
  ['2021/02/IMG_20200605_171300-scaled.jpg', 'Biking up Montebello road and spotting a wild peacock on the road.'],
  ['2021/02/IMG_20200508_171231-scaled.jpg', 'HWY 89 on way to Monitor Pass'],
  ['2021/02/IMG_1925-scaled.jpg', 'Hammocking after climbing up HWY 4'],
  ['2021/02/IMG_1408-scaled.jpg', 'Above the clouds biking up Mount Hamilton'],
  ['2021/02/IMG_1396-scaled.jpg', 'Top of Mount Hamilton 37 miles / 4,946 ft'],
  ['2021/02/IMG_20200629_143240-scaled.jpg', ''],
  ['2021/02/IMG_20200703_165917-scaled.jpg', 'Biking up HWY 4'],
].map(([file, caption]) => ({ src: `${U}/${file}`, caption: caption ?? '' }));
---

<Base>
  <link slot="head" rel="preload" as="image" href={hero.src} imagesrcset={hero.srcset} imagesizes="100vw" fetchpriority="high" />

  <section id="home" class="hero">
    <Pic src={`${U}/2024/06/Monster-All-Wheel-Drive-Handcycle.jpg`} alt="" sizes="100vw" eager class="hero-img" />
    <div class="hero-inner">
      <h1>"Able Bodied" experiences for ALL</h1>
      <p class="hero-sub">Don't let your disability stop you</p>
      <div class="btn-wrap"><a class="btn cyan" href="#services">Book a FREE Lesson</a></div>
      <p>We offer in person and online lessons.</p>
      <p>We also can help you find grants / funding for your own handcycle.</p>
      <a class="insta" href="https://www.instagram.com/ablebodiedorg/" aria-label="Able Bodied on Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM21.9 8.2c-.1-1.5-.4-2.8-1.5-3.9s-2.4-1.4-3.9-1.5c-1.5-.1-6.1-.1-7.6 0-1.5.1-2.8.4-3.9 1.5S3.6 6.7 3.5 8.2c-.1 1.5-.1 6.1 0 7.6.1 1.5.4 2.8 1.5 3.9s2.4 1.4 3.9 1.5c1.5.1 6.1.1 7.6 0 1.5-.1 2.8-.4 3.9-1.5s1.4-2.4 1.5-3.9c.1-1.5.1-6.1 0-7.6zm-2 9.2a3.1 3.1 0 0 1-1.7 1.7c-1.2.5-4 .4-5.2.4s-4.1.1-5.2-.4a3.1 3.1 0 0 1-1.7-1.7c-.5-1.2-.4-4-.4-5.3s-.1-4.1.4-5.2a3.1 3.1 0 0 1 1.7-1.7c1.2-.5 4-.4 5.2-.4s4.1-.1 5.2.4a3.1 3.1 0 0 1 1.7 1.7c.5 1.2.4 4 .4 5.2s.1 4.1-.4 5.3z" /></svg>
      </a>
    </div>
  </section>

  <section id="about" class="section band">
    <div class="wrap narrow">
      <h2 class="heading">About</h2>
      <hr class="divider" />
      <div class="text center">
        <h5>Able Bodied Inc. is a California non-profit corporation founded in May 2024</h5>
        <h4>Our Mission:</h4>
        <p>Help people with disabilities around the world connect and experience “able bodied” adventures.</p>
        <p>Our primary offering is electric assist handcycling currently</p>
      </div>
      <Video id="aWYoOmAazh8" title="What is AbleBodied.org?" />
      <div class="text center">
        <h4 class="gap">Our Values:</h4>
        <p>1. <b>Positive vibes and happiness.</b> Our goal is to feel good and share our happiness with others.</p>
        <p>2. <b>Share and open source</b> our knowledge base with people and organizations around the world</p>
        <p>3.<b> Keep costs low. </b>Frugality → affordability → accessibility for all. Get the cost of an electric assist handcycle below $2,000</p>
        <h4 class="gap">Our Services:</h4>
        <p>
          1. Free in person <b>electric assist handcycling <a href="#services">lessons</a></b><br />
          2. Our <a href="#Get1Help2"><b>Get 1 Help 2</b></a> program<br />
          3. Our open source map / travel guide / wiki to find handcycling places around the world
        </p>
        <h4 class="gap">Our Team:</h4>
        <p>We are a diverse set of life/adventure loving world travelers and DIY tinkerers. <a href="/board-of-directors/">Click here</a> to learn more about our board of directors.</p>
        <h4>News and Events:</h4>
        <p>You can find out about our events by following our <a href={SITE.facebookPage}>Facebook page</a> or checking out our <a href="/blog/">blog</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="heading">Why electric assist handcycling</h2>
      <hr class="divider" />
      <div class="text">
        <p>Electric assist handcycling allows disabled riders to keep up with anybody and enjoy an “able bodied” experience with their friends and family. It is also a sport that can be easily done independently and directly from your house. You could easily hop on a handcycle and bike 50 miles, even if you are severely disabled (see our quad bike <a href="https://www.youtube.com/watch?v=6xu5A22KXDc">review</a>).</p>
      </div>
    </div>
  </section>

  <section id="services" class="section">
    <div class="wrap">
      <h2 class="heading">1-on-1 lessons (in person or virtual)</h2>
      <hr class="divider" />
      <div class="text center">
        <p>We offer free in person and virtual lessons on electric assist handcycling as well a 1:1 mentorship through our <a href={L.get1help2}>Get1Help2</a> program. Our goal is to introduce you to electric assist handcycling and then show you how you can find grants and other funding sources to help you purchase a handcycle of your own.</p>
      </div>
      <div class="cards">
        <article class="card">
          <Pic src={`${U}/2025/11/Screenshot-2025-11-04-at-2.48.01-PM-Medium.jpeg`} alt="Handcycle Lesson" />
          <h3>In person lesson in San Jose CA</h3>
          <div class="text"><p>Free 1:1 lesson on an electric assist handcycle. There is a special ramp to make transferring easier. We have two delta style handcycles and one wheelchair attachable Stricker Tetra Lipo Smart handcycle that is optimized for quadriplegics.</p></div>
          <a class="btn" href={L.scheduleSanJose}>Schedule in San Jose</a>
        </article>
        <article class="card">
          <Pic src={`${U}/2025/11/Screenshot-2025-11-04-at-2.57.29-PM-Medium.jpeg`} alt="" />
          <h3>In person lesson in Sebastopol CA</h3>
          <div class="text"><p>Free 1:1 lesson on an electric assist handcycle. There is a special ramp to make transferring easier. There is a front wheel drive Top End Force 3 and a dual motor full suspension Lasher. Unfortunately none of the handcycles are designed for quadriplegics in this location.</p></div>
          <a class="btn" href={L.scheduleSebastopol}>Schedule in Sebastopol</a>
        </article>
        <article class="card">
          <Pic src={`${U}/2024/06/google-meet-512.webp`} alt="" />
          <h3>Online consultation<br /><span class="sub">(~30 minutes)</span></h3>
          <div class="text"><p>Book a video call to ask any questions about e-assist handcycling. Happy to accommodate different time zones so feel free to e-mail us.</p></div>
          <a class="btn" href={L.scheduleOnline}>Schedule Online Appointment</a>
        </article>
      </div>
    </div>
  </section>

  <section id="Get1Help2" class="section">
    <div class="wrap">
      <h2 class="heading">Get 1 Help 2 Program (fund your own handcycle)</h2>
      <hr class="divider" />
      <div class="text center">
        <p>Out <a href={L.get1help2}>Get 1 Help 2 program</a> is our “Pyramid Scheme for Good” strategy to help people around the world get into electric assist handcycling. We will</p>
        <p>1. Help you figure out what kind of handcycle is best for your needs (find a local handcycle organization on our <a href={SITE.wiki}>wiki</a>)</p>
        <p>2. Help you apply for grants and also host tax deductible fund raisers to help finance your handcycle</p>
        <p>3. Host monthly virtual meetings with other aspiring handcyclists to discuss progress and get inspired/motivated</p>
        <p>All we ask for in return is that you become an <a href="https://www.facebook.com/hashtag/ablebodiedambassador">#AbleBodiedAmbassador</a> and recruit at least two people to join our program.</p>
      </div>
      <div class="btn-wrap"><a class="btn" href={L.get1help2}>Sign up for Get1Help2</a></div>
      <Video id="YSul--bUJc4" title="Our first 2026 #Get1Help2 graduate" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="heading">Open Source Travel &amp; Handcycle Guide</h2>
      <hr class="divider" />
      <div class="text center">
        <p>We put together an open source wiki at <a href={SITE.wiki}>wiki.ablebodied.org</a> that is meant to be the ultimate guide on where you can find a handcycle to ride on. There is a <a href="https://wiki.ablebodied.org/books/handcycle-styles/page/handcycle-style-comparison">handcycle style guide</a> as well as list of <a href="https://wiki.ablebodied.org/shelves/handcycle-manufacturers">handcycle manufacturers</a> you can peruse and improve by updating and improving the information (as it is meant to be an open source resource). Click on the map below to find a handcycle location near you or close to where you might want to travel.</p>
      </div>
      <a href={L.map} aria-label="Open the map of handcycle locations">
        <Pic src={`${U}/2025/11/Screenshot-2025-11-29-at-10.59.41-AM.png`} alt="Map of handcycle locations" sizes="(min-width: 1180px) 1140px, 100vw" />
      </a>
      <div class="btn-wrap spaced"><a class="btn" href={L.map}>Browse map</a></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="heading">Able Bodied Travel Guides</h2>
      <hr class="divider" />
      <div class="text center">
        <p>A key challenge we have found is being able to travel the great outdoors while traveling. Taking your own handcycle is possible, but requires extensive planning of transportation and storage. With this in mind we are hoping to seed a community of fellow adventurers and put together “open source” travel guides that other can add to and improve.. Our guides are written with the wheelchair bound traveler in mind with tips on hotels, where to rent a handcycle, and where to eat (good food makes every trip better).</p>
      </div>
      <div class="cards">
        <article class="card">
          <Pic src={`${U}/2023/10/Screenshot-2023-10-23-at-6.20.53-PM.png`} alt="" />
          <h3>Italy</h3>
          <div class="text">
            <p><b>Amazing food and massive mountains.</b></p>
            <p>Italy is not only the birthplace of the Roman empire, the Renaissance, and pizza, it has some of the most beautiful mountains in Europe.</p>
            <p>Our guide covers the best places to eat, how accessible the hotels we stayed at, and where you can rent a handcycle.</p>
          </div>
          <a class="btn" href={travelGuide}>Travel Guide</a>
        </article>
        <article class="card">
          <Pic src={`${U}/2023/10/Screenshot-2023-10-23-at-6.23.11-PM.png`} alt="" />
          <h3>Poland</h3>
          <div class="text">
            <p><b>Amazing food at amazing prices plus scenic country roads.</b></p>
            <p>In Poland you can eat delicious like a king and pay between 1/3 to 1/2 of what you would pay in the US. Warsaw is one of the most accessible cities in Europe with elevators at every metro station, excellent public transit on wheelchair accessible buses and trollies,.and wide sidewalks with curb cuts. Wroclaw is another awesome city with rentable handcycles.</p>
          </div>
          <a class="btn" href={survey}>Travel Guide</a>
        </article>
        <article class="card">
          <Pic src={`${U}/2025/10/California.webp`} alt="" />
          <h3>California</h3>
          <div class="text">
            <p><b>Amazing natural beauty with limitless trail systems</b></p>
            <p>California offers many different playgrounds with adaptive programs all over the state. If it is Lake Tahoe, Mammoth, or just the Bay Area, there are plenty of options to rent a handcycle and get off the beaten path..</p>
          </div>
          <a class="btn" href={survey}>Travel Guide</a>
        </article>
        <article class="card">
          <Pic src={`${U}/2025/10/Screenshot-2025-10-24-at-2.13.43-PM.png`} alt="" />
          <h3>France</h3>
          <div class="text">
            <p><b>Amazing food and massive mountains.</b></p>
            <p>We highly recommend a flight to Lyon, the epicurean capital of France, where you can rent a minivan on Turo and go check out Chamonix and the French riviera. Our guide has an extensive list of places you can rent either handcycles or off-road quadtrixes that you can use to explore some of the most rugged and beautiful terrain in the world.</p>
          </div>
          <a class="btn" href={travelGuide}>Travel Guide</a>
        </article>
        <article class="card">
          <Pic src={`${U}/2025/10/Screenshot-2025-10-24-at-2.16.07-PM.png`} alt="" />
          <h3>Germany</h3>
          <div class="text">
            <p><b>Great beer, innovative handcycles, and ancient castles</b></p>
            <p>Germany has a long history of engineering, manufacturing, and great beer. It is home to several handcycle manufacturers including Stricker the oldest wheelchair attachable handcycle. It is also home to some interesting towns, castles, and fun trails to go handcycling on</p>
          </div>
          <a class="btn" href={survey}>Travel Guide</a>
        </article>
        <article class="card">
          <Pic src={`${U}/2025/10/modern-question-mark-template-idea-message-vector-isolated-white-background-11_1119689-5070.avif`} alt="" />
          <h3>Request a guide</h3>
          <div class="text">
            <p><b>Or help us write one</b></p>
            <p>All our guides are written in a simple Google doc that is available for anybody to read and/or edit. Feel free to copy one and follow the format to create your own guide and share it with the community. Or request one. Either way, take our quick survey to let us know..</p>
          </div>
          <a class="btn" href={survey}>Take survey</a>
        </article>
      </div>
      <hr class="divider" />
    </div>
  </section>

  <section id="gallery" class="section band">
    <div class="wrap">
      <h2 class="heading">Gallery</h2>
      <hr class="divider" />
      <Gallery photos={gallery} label="Gallery" />
    </div>
  </section>

  <section id="mywork" class="section">
    <div class="wrap">
      <h2 class="heading">How to convert a manual handcycle to electric</h2>
      <hr class="divider" />
      <div class="text center">
        <p>We have completed three different types of handcyckle ebike conversions. Buying a manual handcycle and adding electric assist is by far the least expensive way to get into the sport. We have purchased a used Top End Force 3 on Facebook marketplace for $500 and added a motor to it for under $1,000, which is significantly less than new electric assist handcycles, which frequently go for $10K+..</p>
      </div>
      <div class="cards">
        <article class="card">
          <Pic src={`${U}/2022/09/Bafang-Conversion.jpeg`} alt="" />
          <h3>Bafang Front Wheel Drive<br />~$1,000</h3>
          <div class="text">
            <p><b>Excellent beginner bike.</b></p>
            <p><b>Easiest to build and operate.</b></p>
            <p><b>Go 50 miles+</b></p>
            <p>The goal of this e-bike conversion was to minimize cost and deliver a bike that could be reproduced in Ukraine (<a href="https://www.gofundme.com/f/nfddcy-help-ukrainians-with-disabilities">project details</a>). This build is not only less expensive, but a lot easier to put together and operate. It is not hard to find a used handcycle for $2,000, making the total cost of this e-assist handcycle ~$3,000. We recommend you get a handcycle with at least a disc brake in the front to have enough stopping power.</p>
          </div>
          <a class="btn" href={buildForm}>Build Details</a>
        </article>
        <article class="card">
          <Pic src={`${U}/2026/03/Screenshot-2026-03-13-at-9.52.51-AM.png`} alt="" />
          <h3>Direct Drive Front Wheel<br />~$2,500</h3>
          <div class="text">
            <p><b>Perfect road bike</b></p>
            <p><b>Regen braking &amp; quad friendly</b></p>
            <p><b>Go 60 miles+</b></p>
            <p>This is a great option for someone interested in going on long road bike rides that may have long climbs and descents. It is simpler than building the all-wheel drive bike and will provide regenerative braking to maintain your speed on descents. You can trigger regen by pedaling backwards, which is an awesome feature for quadriplegics or users with limited hand function that prevents them from being able to squeeze a regular brake lever.</p>
          </div>
          <a class="btn" href="https://docs.google.com/document/d/1eae5VK7FJt35_gz1tfWpUS3cownYP0U_4DrgKW-XK70/edit?tab=t.0#heading=h.nbrzm799uk83">Build Details</a>
        </article>
        <article class="card">
          <Pic src={`${U}/2022/09/IMG_7339.jpg`} alt="" />
          <h3>All Wheel Drive "Beast"<br />~$5,000</h3>
          <div class="text">
            <p><b>Off-road dream machine</b></p>
            <p><b>Get off the paved roads!</b></p>
            <p><b>Go 70 miles+</b></p>
            <p>This bike will ride up steep sandy fire roads and even snow covered ski slopes. It has two 1500W motors in the back and hand powered propulsion in the front, so is basically all wheel drive.</p>
          </div>
          <a class="btn" href={buildForm}>Build Details</a>
        </article>
      </div>
      <hr class="divider" />
    </div>
  </section>

  <section class="section contact">
    <div class="wrap">
      <div class="boxes">
        <div><h5>E-mail Us</h5><p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p></div>
        <div><h5>Our Locations</h5><p>San Jose, CA 95124<br />Sebastopol CA</p></div>
        <div><h5>Open Hours</h5><p>By appointment only</p></div>
        <div><h5>Follow Us</h5><Social /></div>
      </div>
      <hr class="divider" />
      <div class="text legal">
        <p><b>Able Bodied Inc.</b> is a nonprofit, tax-exempt charitable organization (tax ID number {SITE.ein}) under Section 501(c)(3) of the Internal Revenue Code. Donations are tax-deductible as allowed by law.</p>
        <p><a href="/privacy-policy/">Privacy Policy</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: min(990px, 100svh);
    display: grid;
    place-items: center;
    text-align: center;
    overflow: hidden;
    background: #222;
  }
  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.5);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    padding: 80px 20px;
    color: #f7eded;
    font-family: var(--roboto);
  }
  .hero h1 {
    color: #fff;
    font-size: 40px;
    margin-bottom: 14px;
  }
  .hero-sub {
    font-family: Arial, sans-serif;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: 8.4px;
    color: #d5d5d5;
    margin-bottom: 24px;
  }
  .hero .btn-wrap {
    margin-bottom: 28px;
  }
  .insta {
    display: inline-block;
    margin-top: 16px;
  }
  .insta svg {
    width: 50px;
    height: 50px;
    fill: var(--blue);
  }
  @media (max-width: 767px) {
    .hero h1 {
      font-size: 30px;
    }
    .hero-sub {
      font-size: 16px;
      letter-spacing: 4px;
    }
  }
  .narrow {
    width: min(100% - 40px, 980px);
  }
  .gap {
    margin-top: 1.4em;
  }
  #about .text h5 {
    margin-top: 10px;
  }
  .card .sub {
    color: var(--dark);
    font-size: 18px;
  }
  .spaced {
    margin-top: 40px;
  }
  .boxes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    text-align: center;
  }
  @media (max-width: 767px) {
    .boxes {
      grid-template-columns: 1fr 1fr;
    }
  }
  .boxes h5 {
    color: var(--blue);
    font-size: 20px;
    margin-bottom: 10px;
  }
  .boxes p {
    color: var(--text);
    font-family: var(--roboto);
    margin: 0;
  }
  .boxes a {
    color: inherit;
    text-decoration: none;
  }
  .contact {
    padding-bottom: 10px;
  }
  .legal b {
    color: var(--body);
  }
</style>
