---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { SITE } from '../lib/site';

const U = '/wp-content/uploads/2024/10';
const stockMail = `mailto:${SITE.donateEmail}?subject=${encodeURIComponent('Stock donation')}&body=${encodeURIComponent(
  'I pledge to donate\n\n# of shares:\nTicker:\n\nPlease send me transfer instructions.',
)}`;
---

<Base title="Donate" description="Donate to Able Bodied Inc., a 501(c)(3) nonprofit, by card, PayPal, Venmo, Zelle, stock or employer matching.">
  <section class="section">
    <div class="wrap">
      <h1>Donate</h1>
      <p class="lead">Your gift funds free lessons, handcycles and open resources for riders with disabilities. Able Bodied Inc. is a 501(c)(3) nonprofit, so donations are tax-deductible as allowed by law.</p>

      <div class="ways">
        <article class="card">
          <div class="card-body">
            <h2>Card or PayPal</h2>
            <p>Give with a debit card, credit card or PayPal account.</p>
            <a class="btn accent" href={SITE.links.paypal}>Donate with card or PayPal</a>
          </div>
        </article>

        <article class="card">
          <div class="card-body">
            <h2>Employer matching <span class="badge">Highest impact</span></h2>
            <p>Many companies match employee donations, often dollar for dollar. Ask your HR or benefits team. Look us up as <strong>Able Bodied Inc.</strong>: we’re registered with Benevity and GuideStar, which awarded us its <a href={SITE.links.guidestar}>Gold Seal of Transparency</a>, and can take employer-matched donations through most company intranets (for example <a href={SITE.links.benevity}>Google’s Benevity portal</a>).</p>
            <p><strong>Note:</strong> Google matches stock donations and donations from donor-advised funds, so you can combine a stock gift with employer matching.</p>
          </div>
        </article>

        <article class="card">
          <div class="card-body">
            <h2>Donate stock</h2>
            <p>Give appreciated stock, deduct its full value, and pay no capital gains tax. If you live in California and hold highly appreciated stock, you can get almost 80% of your donation back in tax savings. Send us your pledge and we’ll reply with instructions.</p>
            <a class="btn" href={stockMail}>Pledge a stock donation</a>
          </div>
        </article>
      </div>

      <h2 class="phone-h">Donate from your phone</h2>
      <ul class="qr">
        <li class="card">
          <Pic src={`${U}/Screenshot-2024-10-12-at-4.48.48-PM.png`} alt="Zelle QR code for Able Bodied Inc." sizes="240px" />
          <div class="card-body">
            <h3>Zelle <span class="badge">No fees</span></h3>
            <p>Our preferred way. Open your Zelle app and send to <strong>{SITE.donateEmail}</strong>.</p>
          </div>
        </li>
        <li class="card">
          <Pic src={`${U}/Screenshot-2024-10-18-at-4.10.15-PM.png`} alt="PayPal QR code for Able Bodied Inc." sizes="240px" />
          <div class="card-body">
            <h3>PayPal</h3>
            <p>1.9% service fee. <a href={SITE.links.paypal}>Open PayPal</a></p>
          </div>
        </li>
        <li class="card">
          <Pic src={`${U}/Screenshot-2024-10-18-at-4.37.22-PM.png`} alt="Venmo QR code for @AbleBodiedInc" sizes="240px" />
          <div class="card-body">
            <h3>Venmo</h3>
            <p>1.9% service fee. <a href={SITE.links.venmo}>@AbleBodiedInc</a></p>
          </div>
        </li>
      </ul>

      <section class="details" aria-labelledby="org">
        <h2 id="org">Organization details</h2>
        <dl>
          <dt>Organization name</dt><dd>Able Bodied Inc.</dd>
          <dt>EIN</dt><dd>{SITE.ein}</dd>
          <dt>Mailing address</dt><dd>{SITE.mailingAddress.map((l) => <>{l}<br /></>)}</dd>
          <dt>Email</dt><dd><a href={`mailto:${SITE.donateEmail}`}>{SITE.donateEmail}</a></dd>
          <dt>Website</dt><dd>https://ablebodied.org/</dd>
        </dl>
      </section>
    </div>
  </section>
</Base>

<style>
  .ways {
    display: grid;
    gap: 20px;
    margin: 32px 0 48px;
  }
  @media (min-width: 900px) {
    .ways {
      grid-template-columns: 1fr 1.4fr 1fr;
    }
  }
  .ways h2 {
    font-size: 1.35rem;
  }
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    vertical-align: middle;
    background: var(--brand-soft);
    color: var(--ink);
    border-radius: 999px;
    padding: 2px 10px;
    font-weight: 700;
  }
  .qr {
    list-style: none;
    padding: 0;
    margin: 16px 0 48px;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }
  .qr :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    background: #fff;
    padding: 12px;
  }
  .details dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 8px 20px;
  }
  .details dt {
    font-weight: 700;
  }
  .details dd {
    margin: 0;
  }
</style>
