---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import Pic from '../../../../components/Pic.astro';
import PostMeta from '../../../../components/PostMeta.astro';
import { allPosts, postParts, postUrl, type Post } from '../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post, i) => ({
    params: postParts(post),
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, cover, description } = post.data;
---

<Base title={title} description={description} image={cover} type="article">
  <div class="boxed">
    <div class="wrap">
      <article class="entry">
        {cover && <div class="entry-cover"><Pic src={cover} alt="" sizes="(min-width: 1240px) 1110px, 100vw" eager /></div>}
        <h1 class="entry-title">{title}</h1>
        <PostMeta post={post} />
        <div class="prose">
          <Content />
        </div>
      </article>
      <nav class="entry post-nav" aria-label="Posts">
        {older ? <a href={postUrl(older)} rel="prev">← Previous Post</a> : <span></span>}
        {newer && <a href={postUrl(newer)} rel="next">Next Post →</a>}
      </nav>
    </div>
  </div>
</Base>

<style>
  .post-nav {
    display: flex;
    justify-content: space-between;
    padding-block: 25px;
  }
  .post-nav a {
    text-decoration: none;
  }
</style>
