---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { allPosts, CATEGORIES, longDate, postParts, postUrl, type Post } from '../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post, i) => ({
    params: postParts(post),
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, date, categories, cover, description } = post.data;
const shown = categories.filter((c) => CATEGORIES[c]);
---

<Base title={title} description={description} image={cover ? cover : undefined} type="article">
  <article class="section">
    <div class="narrow">
      <p class="meta">
        <a href="/blog/">News</a> ·
        <time datetime={date.toISOString().slice(0, 10)}>{longDate(date)}</time>
        {shown.map((c) => <> · <a href={`/category/${c}/`}>{CATEGORIES[c]}</a></>)}
      </p>
      <h1>{title}</h1>
      <div class="prose">
        <Content />
      </div>

      <nav class="pager" aria-label="More posts">
        {older ? <a href={postUrl(older)} rel="prev"><span>Older</span>{older.data.title}</a> : <span></span>}
        {newer && <a href={postUrl(newer)} rel="next" class="next"><span>Newer</span>{newer.data.title}</a>}
      </nav>

      <aside class="support">
        <h2>Support riders like these</h2>
        <p>Able Bodied Inc. is a 501(c)(3) nonprofit. Donations are tax-deductible.</p>
        <a class="btn accent" href="/donate/">Donate</a>
      </aside>
    </div>
  </article>
</Base>

<style>
  .meta {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .pager a {
    text-decoration: none;
    font-weight: 600;
    color: var(--ink);
  }
  .pager a:hover {
    color: var(--link);
  }
  .pager span {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-2);
  }
  .pager .next {
    text-align: right;
  }
  .support {
    margin-top: 40px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--brand-soft);
  }
  .support h2 {
    font-size: 1.35rem;
  }
</style>
