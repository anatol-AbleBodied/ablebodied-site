---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="boxed">
    <div class="wrap">
      <article class="entry">
        <h1 class="entry-title">This page doesn't seem to exist.</h1>
        <div class="prose">
          <p>It looks like the link pointing here was faulty. Try the <a href="/">home page</a> or the <a href="/blog/">blog</a>.</p>
        </div>
      </article>
    </div>
  </div>
</Base>
