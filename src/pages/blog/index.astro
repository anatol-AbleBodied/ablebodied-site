---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts } from '../../lib/posts';

const posts = await allPosts();
---

<Base title="Blog">
  <div class="boxed">
    <div class="wrap">
      <h1 class="visually-hidden">Blog</h1>
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </div>
</Base>
