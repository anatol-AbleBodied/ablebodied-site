---
/** Round social buttons with each network's official logo and colour (from Simple Icons). */
import { siFacebook, siInstagram, siTiktok, siYoutube } from 'simple-icons';
import { SITE } from '../lib/site';

const icons: Record<string, { path: string; bg: string }> = {
  YouTube: { path: siYoutube.path, bg: `#${siYoutube.hex}` },
  Facebook: { path: siFacebook.path, bg: `#${siFacebook.hex}` },
  Instagram: {
    path: siInstagram.path,
    bg: 'radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285aeb 90%)',
  },
  TikTok: { path: siTiktok.path, bg: `#${siTiktok.hex}` },
};
---

<ul class="social">
  {
    SITE.social.map((s) => (
      <li>
        <a href={s.href} style={`background:${icons[s.label].bg}`} aria-label={s.label} title={s.label}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={icons[s.label].path} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    transition: transform 0.15s ease, filter 0.15s ease;
  }
  .social svg {
    width: 18px;
    height: 18px;
    fill: #fff;
  }
  @media (max-width: 767px) {
    .social {
      gap: 6px;
    }
    .social a {
      width: 32px;
      height: 32px;
    }
    .social svg {
      width: 16px;
      height: 16px;
    }
  }
  .social a:hover,
  .social a:focus-visible {
    transform: translateY(-2px);
    filter: brightness(1.08);
  }
</style>
