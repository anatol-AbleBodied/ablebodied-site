---
import { picture } from '../lib/picture.mjs';

interface Props {
  /** Address of an uploaded photo, e.g. /wp-content/uploads/2024/06/Wojtek.jpeg */
  src: string;
  alt: string;
  /** How wide the photo shows, for the browser to pick a copy. */
  sizes?: string;
  /** For the first big photo on a page: load it straight away. */
  eager?: boolean;
  class?: string;
}

const { src, alt, sizes = '(min-width: 760px) 360px, 100vw', eager = false, class: className } = Astro.props;
const pic = picture(src);
---

<img
  src={pic.src}
  srcset={pic.srcset}
  sizes={pic.srcset ? sizes : undefined}
  width={pic.width}
  height={pic.height}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  class={className}
/>
