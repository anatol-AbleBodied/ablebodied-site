---
import Pic from './Pic.astro';
import PostMeta from './PostMeta.astro';
import { excerpt, postUrl, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const url = postUrl(post);
---

<article class="entry">
  {
    post.data.cover && (
      <a href={url} class="entry-cover" tabindex="-1" aria-hidden="true">
        <Pic src={post.data.cover} alt="" sizes="(min-width: 1240px) 1110px, 100vw" />
      </a>
    )
  }
  <h2 class="entry-title"><a href={url}>{post.data.title}</a></h2>
  <PostMeta post={post} />
  <div class="prose">
    <p>{excerpt(post)}</p>
  </div>
  <a class="read-more" href={url}>Read More »<span class="visually-hidden"> about {post.data.title}</span></a>
</article>

<style>
  .entry-cover {
    display: block;
  }
</style>
